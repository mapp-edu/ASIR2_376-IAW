# Copia este archivo como .env y rellena los valores.
# El archivo .env no se sube al repositorio (está en .gitignore).

# Contraseña del usuario root de MariaDB
DB_ROOT_PASSWORD=

# Base de datos y usuario propios de la aplicación
DB_NAME=
DB_USER=
DB_PASSWORD=

# Zona horaria del servidor web y de la base de datos (opcional, por defecto Europe/Madrid)
TZ_WEB=
